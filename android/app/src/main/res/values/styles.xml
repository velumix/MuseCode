<resources>
    <color name="muse_background">#101214</color>
    <color name="muse_blue">#4285F4</color>
    <color name="muse_text">#F1F3F6</color>
    <color name="muse_muted">#9CA3AF</color>
    <style name="Theme.MuseCode" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowBackground">@color/muse_background</item>
        <item name="android:colorAccent">@color/muse_blue</item>
        <item name="colorAccent">@color/muse_blue</item>
        <item name="android:windowActionModeOverlay">true</item>
    </style>
    <style name="Theme.MuseCode.Scanner" parent="Theme.MuseCode">
        <item name="android:windowFullscreen">true</item>
    </style>
    <style name="MuseButton" parent="Widget.AppCompat.Button.Borderless">
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/muse_text</item>
        <item name="android:textSize">15sp</item>
        <item name="android:minHeight">52dp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>
</resources>
